+            lim = getattr(props, "shared_memory_per_block", 0)
+        if not lim:
+            if torch.version.hip:
+                lim = 64 * 1024
+            else:
+                lim = 64 * 1024 if props.major < 8 else 96 * 1024
         if _env_limit:
             lim = min(lim, _env_limit)
